# Only sync note documents and image attachments; keep all other files local.
*
!*/
!/.gitignore

# Markdown, Word, PDF, text notes, slides and spreadsheets (case insensitive).
!*.[mM][dD]
!*.[mM][aA][rR][kK][dD][oO][wW][nN]
!*.[dD][oO][cC]
!*.[dD][oO][cC][xX]
!*.[pP][dD][fF]
!*.[rR][tT][fF]
!*.[oO][dD][tT]
!*.[tT][xX][tT]
!*.[pP][pP][tT]
!*.[pP][pP][tT][xX]
!*.[oO][dD][pP]
!*.[xX][lL][sS]
!*.[xX][lL][sS][xX]
!*.[oO][dD][sS]
!*.[cC][sS][vV]
!*.[tT][sS][vV]

# Keep note images so Markdown attachments continue to render.
!*.[pP][nN][gG]
!*.[jJ][pP][gG]
!*.[jJ][pP][eE][gG]
!*.[gG][iI][fF]
!*.[wW][eE][bB][pP]
!*.[sS][vV][gG]
!*.[bB][mM][pP]
!*.[tT][iI][fF]
!*.[tT][iI][fF][fF]
!*.[aA][vV][iI][fF]
!*.[hH][eE][iI][cC]

# App settings, helper skills, dependencies, caches and generated environments.
.obsidian/
.codex/
.agents/
.idea/
.vscode/
.runtime/
.venv/
venv/
env/
node_modules/
site-packages/
__pycache__/
*.dist-info/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Database runtime files and dependency manifests are not notes.
**/mysql/data/
requirements*.txt
CMakeLists.txt

# Office lock files and local temporary copies.
~$*
*.tmp
*.temp
*.bak
